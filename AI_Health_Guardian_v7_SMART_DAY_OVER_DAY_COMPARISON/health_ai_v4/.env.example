# Copy this file to .env and fill in your own key, OR use
# .streamlit/secrets.toml instead (see .streamlit/secrets.toml.example) --
# you only need one of the two. .env is gitignored and will never be
# committed, unlike this .example file.
#
# Get a free key from https://aistudio.google.com/apikey
#
# This key is optional: the app works fully without it, just with the
# simpler rule-based chat assistant instead of the full conversational one.

GEMINI_API_KEY=your-key-here

# Optional backup keys: if the primary key above hits its free-tier daily
# request quota, the app automatically switches to the next one configured
# here, in order, before falling back to the rule-based assistant. All
# optional -- only GEMINI_API_KEY is required.
# GEMINI_API_KEY_2=your-second-key-here
# GEMINI_API_KEY_3=your-third-key-here
# GEMINI_API_KEY_4=your-fourth-key-here
