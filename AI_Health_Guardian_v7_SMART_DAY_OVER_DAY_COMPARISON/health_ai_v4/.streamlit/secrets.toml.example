# Copy this file to .streamlit/secrets.toml and fill in your own key.
# secrets.toml is gitignored -- it will NEVER be committed, unlike this
# .example file. Never put a real key directly in this .example file.
#
# Get a free key from https://aistudio.google.com/apikey
#
# This key is optional: the app works fully without it, just with the
# simpler rule-based chat assistant instead of the full conversational one,
# and the free (less reliable) voice-transcription path instead of Gemini's.

GEMINI_API_KEY = "your-key-here"
